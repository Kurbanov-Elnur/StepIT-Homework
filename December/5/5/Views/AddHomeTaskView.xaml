<UserControl x:Class="_5.Views.AddHomeTaskView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:_5.Views"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="400">
    <Grid
        Background="Transparent">

        <Border
            VerticalAlignment="Center"
            HorizontalAlignment="Center"
            Width="380"
            Height="680"
            Background="#101025">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <TextBox
                    md:HintAssist.Hint="Description"
                    Text="{Binding Description}"
                    Background="Transparent"
                    BorderThickness="0"
                    VerticalAlignment="Center"
                    Width="300"
                    Height="100"
                    FontSize="25"
                    Foreground="White"
                    Style="{DynamicResource MaterialDesignDataGridTextColumnEditingStyle}">
                </TextBox>

                <TextBox
                    Grid.Row="1"
                    md:HintAssist.Hint="Room"
                    Text="{Binding Room}"
                    Background="Transparent"
                    BorderThickness="0"
                    VerticalAlignment="Center"
                    Width="300"
                    Height="100"
                    FontSize="25"
                    Foreground="White"
                    Style="{DynamicResource MaterialDesignDataGridTextColumnEditingStyle}">
                </TextBox>

                <TextBox
                    Grid.Row="2"
                    md:HintAssist.Hint="IsHousekeeping"
                    Text="{Binding IsHousekeeping}"
                    Background="Transparent"
                    BorderThickness="0"
                    VerticalAlignment="Center"
                    Width="300"
                    Height="100"
                    FontSize="25"
                    Foreground="White"
                    Style="{DynamicResource MaterialDesignDataGridTextColumnEditingStyle}">

                </TextBox>


                <TextBox
                    Grid.Row="3"
                    md:HintAssist.Hint="ResponsiblePerson"
                    Text="{Binding ResponsiblePerson}"
                    Background="Transparent"
                    BorderThickness="0"
                    VerticalAlignment="Center"
                    Width="300"
                    Height="100"
                    FontSize="25"
                    Foreground="White"
                    Style="{DynamicResource MaterialDesignDataGridTextColumnEditingStyle}">

                </TextBox>

                <DatePicker
                    SelectedDate="{Binding DeadLine}"
                    Grid.Row="4"
                    Width="200"
                    Height="100"
                    Background="White">
                </DatePicker>

                <Button
                    Command="{Binding AddTask}"
                    Grid.Row="5"
                    Width="100"
                    Height="60">

                    <md:PackIcon Kind="Plus" Width="30" Height="30"/>
                </Button>
            </Grid>

        </Border>
    </Grid>
</UserControl>
