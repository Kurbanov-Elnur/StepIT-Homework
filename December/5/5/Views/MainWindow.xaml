<Window x:Class="_5.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_5"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="MainWindow" AllowsTransparency="True" Height="700" Width="400" Background="Transparent" WindowStyle="None">
    
    <Grid
        MouseDown="Grid_MouseDown"
        Background="#101025">

        <Grid.RowDefinitions>
            <RowDefinition Height="0.06*"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Button 
            HorizontalAlignment="Right"
            Click="Minimize_Click"
            Name="Minimize"
            Margin="0 0 50 0"
            Style="{DynamicResource MaterialDesignFlatButton}">
            
            <md:PackIcon Kind="Minimize" Foreground="White"/>
        </Button>

        <Button 
            HorizontalAlignment="Right"
            Click="Close_Click"
            Name="Close"
            Style="{DynamicResource MaterialDesignFlatButton}">
            
            <md:PackIcon Kind="Close" Foreground="White"/>
        </Button>

        <ContentControl Grid.Row="1" Content="{Binding CurrentView}"/>
        
    </Grid>
</Window>
